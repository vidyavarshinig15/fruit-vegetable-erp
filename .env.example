# -----------------------------------------------------------------------------
# RAJU FRUITS & VEGETABLES ERP BILLING SYSTEM - ENVIRONMENT SETUP CONFIGURATIONS
# -----------------------------------------------------------------------------

# Express backend port configuration
PORT=5001
NODE_ENV=production

# Supabase database connections keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-secret

# JWT token signing passphrase
JWT_SECRET=production-secret-jwt-token-signing-passphrase

# Allowed Client Origin lists (CORS origins)
CORS_ORIGIN=https://billing.rajuwholesale.com,http://localhost:5173

# -----------------------------------------------------------------------------
# COMMUNICATIONS PROVIDERS SETUPS
# -----------------------------------------------------------------------------

# WhatsApp Meta Cloud API (Optional backend bypass settings)
META_WHATSAPP_TOKEN=your-meta-cloud-permanent-token
META_PHONE_NUMBER_ID=your-whatsapp-phone-id

# Email SMTP / Resend API
RESEND_API_KEY=re_your_api_key_credentials
SENDER_FROM_EMAIL=billing@rajuwholesale.com
